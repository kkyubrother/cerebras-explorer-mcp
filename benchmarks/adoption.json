{
  "name": "agent-adoption-readonly-exploration",
  "description": "Benchmarks focused on whether explorer output lets parent coding agents avoid broad native re-search: direct answer, minimal evidence or targets, state, and next-action quality.",
  "defaultPassScore": 0.72,
  "cases": [
    {
      "id": "locate-relevant-code",
      "description": "Find relevant implementation files when the exact location is unknown.",
      "tool": "find_relevant_code",
      "args": {
        "query": "Where is MCP tools/list assembled and which files should be read before changing tool metadata?",
        "scope": ["src/**", "tests/**"]
      },
      "expectations": [
        {
          "label": "Direct answer identifies server tool registry",
          "source": "direct_answer",
          "groups": [["src/mcp/server.mjs"], ["buildToolList"]],
          "weight": 0.35
        },
        {
          "label": "Targets include implementation and tests",
          "source": "target_paths",
          "groups": [["src/mcp/server.mjs"], ["tests/mcp-server.test.mjs"]],
          "weight": 0.3
        }
      ],
      "checks": [
        { "label": "Has direct answer", "type": "has_direct_answer", "value": true, "weight": 0.1 },
        { "label": "Returns targets", "type": "min_target_count", "value": 2, "weight": 0.15 }
      ]
    },
    {
      "id": "trace-symbol",
      "description": "Trace a known symbol without manual grep/read.",
      "tool": "trace_symbol",
      "args": {
        "symbol": "formatParentHandoffText",
        "scope": ["src/**"]
      },
      "expectations": [
        {
          "label": "Answer explains parent text formatting and its consumer",
          "source": "combined_text",
          "groups": [["src/explorer/parent-payload.mjs"], ["buildParentPayload"]],
          "weight": 0.45
        },
        {
          "label": "Evidence points to parent payload code",
          "source": "evidence_paths",
          "groups": [["src/explorer/parent-payload.mjs"]],
          "weight": 0.25
        }
      ],
      "checks": [
        { "label": "Structured evidence retained", "type": "min_evidence_count", "value": 1, "weight": 0.2 }
      ]
    },
    {
      "id": "trace-symbol-cross-check",
      "description": "Trace a symbol's definition and callsites; the usage cross-check must be satisfied.",
      "tool": "trace_symbol",
      "args": {
        "symbol": "buildParentHandoffResponse",
        "scope": ["src/**"]
      },
      "expectations": [
        {
          "label": "Combined text describes the response builder and production callers",
          "source": "combined_text",
          "groups": [["src/mcp/server.mjs"], ["callTool", "handleRequest"]],
          "weight": 0.4
        },
        {
          "label": "Evidence includes the response builder and callers",
          "source": "evidence_paths",
          "groups": [["src/mcp/server.mjs"]],
          "weight": 0.3
        }
      ],
      "checks": [
        { "label": "Structured evidence retained", "type": "min_evidence_count", "value": 2, "weight": 0.2 }
      ]
    },
    {
      "id": "map-change-impact",
      "description": "Map likely blast radius before an edit.",
      "tool": "map_change_impact",
      "args": {
        "change": "Add a new top-level field to explore_repo structured output",
        "scope": ["src/**", "tests/**", "*.md", "examples/**"]
      },
      "expectations": [
        {
          "label": "Answer covers runtime, schema, server, tests, and public contract docs",
          "source": "combined_text",
          "groups": [["schemas.mjs"], ["runtime.mjs"], ["server.mjs"], ["schemas.test.mjs", "runtime.mock.test.mjs", "mcp-server.test.mjs"], ["README.md"], ["DESIGN.md"], ["expected-response.json"]],
          "weight": 0.3
        },
        {
          "label": "Targets include each required impact category",
          "source": "target_paths",
          "groups": [["src/explorer/schemas.mjs"], ["src/explorer/runtime.mjs"], ["src/mcp/server.mjs"], ["tests/schemas.test.mjs", "tests/runtime.mock.test.mjs", "tests/mcp-server.test.mjs"], ["README.md"], ["DESIGN.md"], ["examples/expected-response.json"]],
          "weight": 0.25
        },
        {
          "label": "Targets describe actionability",
          "source": "target_reasons",
          "groups": [["schema"], ["runtime", "normaliz"], ["regression", "validation"], ["documentation", "contract"]],
          "weight": 0.15
        }
      ],
      "checks": [
        { "label": "Returns at least seven targets", "type": "min_target_count", "value": 7, "weight": 0.2 }
      ]
    },
    {
      "id": "explain-code-path",
      "description": "Explain request flow through MCP handler.",
      "tool": "explain_code_path",
      "args": {
        "pathQuery": "MCP tools/call request flow from JSON-RPC handler to exploreRepository",
        "knownFiles": ["src/mcp/server.mjs"],
        "scope": ["src/**"]
      },
      "expectations": [
        {
          "label": "Flow covers transport, dispatch, runtime, and response",
          "source": "combined_text",
          "groups": [["dispatchMessage"], ["handleRequest"], ["callTool"], ["ExplorerRuntime"]],
          "weight": 0.4
        },
        {
          "label": "Evidence includes transport and runtime beyond the known server anchor",
          "source": "evidence_paths",
          "groups": [["src/mcp/jsonrpc-stdio.mjs"], ["src/explorer/runtime.mjs"]],
          "weight": 0.3
        }
      ],
      "checks": [
        { "label": "Structured evidence retained", "type": "min_evidence_count", "value": 3, "weight": 0.2 }
      ]
    },
    {
      "id": "collect-evidence",
      "description": "Refute a specific claim with direct source evidence.",
      "tool": "collect_evidence",
      "args": {
        "claim": "The deterministic critic skips evidence grounding and never checks whether cited ranges were observed",
        "scope": ["src/**", "tests/**"]
      },
      "expectations": [
        {
          "label": "Answer refutes the claim and names the actual grounding flow",
          "source": "combined_text",
          "groups": [["false", "refutes", "refuted", "contradicted", "does not skip"], ["checkEvidenceGrounding"], ["groundEvidenceList"]],
          "weight": 0.5
        },
        {
          "label": "Evidence points to the critic grounding implementation",
          "source": "evidence_paths",
          "groups": [["src/explorer/critic.mjs"]],
          "weight": 0.2
        }
      ],
      "checks": [
        { "label": "Has direct answer", "type": "has_direct_answer", "value": true, "weight": 0.1 },
        { "label": "Structured evidence retained", "type": "min_evidence_count", "value": 1, "weight": 0.1 }
      ]
    },
    {
      "id": "explore-recent-change-context",
      "description": "Use the general explorer for recent changes that need git-guided context.",
      "tool": "explore_repo",
      "args": {
        "task": "What changed in commit ca99b4d4fef6bd8d252d4a2d66c1d8f647ba58c4 around MCP tool metadata and what should be reviewed?",
        "scope": ["src/**", "tests/**"]
      },
      "expectations": [
        {
          "label": "Answer discusses change context",
          "source": "combined_text",
          "groups": [["server.mjs"], ["TOOL_DISPATCH_RULE"]],
          "weight": 0.55
        }
      ],
      "checks": [
        { "label": "Targets present", "type": "min_target_count", "value": 1, "weight": 0.15 },
        { "label": "Git evidence retained", "type": "min_git_evidence_count", "value": 1, "weight": 0.2 }
      ]
    },
    {
      "id": "structured-output-contract",
      "description": "Verify structured output contract fields for parent agent handoff.",
      "tool": "find_relevant_code",
      "args": {
        "query": "Which code controls explore_repo output formatting and structuredContent fields?",
        "knownSymbols": ["formatParentHandoffText", "buildParentPayload", "normalizeExploreResult"],
        "scope": ["src/**", "tests/**"]
      },
      "expectations": [
        {
          "label": "Answer mentions formatting and normalization",
          "source": "combined_text",
          "groups": [["src/explorer/parent-payload.mjs"], ["src/explorer/schemas.mjs"], ["src/mcp/server.mjs", "src/explorer/runtime.mjs"]],
          "weight": 0.45
        },
        {
          "label": "State is actionable",
          "source": "result_state",
          "groups": [["complete", "verify_targets"]],
          "weight": 0.15
        }
      ],
      "checks": [
        { "label": "Has direct answer", "type": "has_direct_answer", "value": true, "weight": 0.1 },
        { "label": "Targets present", "type": "min_target_count", "value": 3, "weight": 0.2 }
      ]
    },
    {
      "id": "direct-vs-explorer-boundary",
      "description": "Boundary case checks that explorer gives narrow targets instead of encouraging broad native re-search.",
      "tool": "find_relevant_code",
      "args": {
        "query": "I need to update README examples for explore_repo return fields. What exact targets should I read?",
        "knownFiles": ["README.md"]
      },
      "expectations": [
        {
          "label": "Answer identifies authoritative schema constants",
          "source": "combined_text",
          "groups": [["PARENT_HANDOFF_V3_SCHEMA", "EXPLORE_REPO_OUTPUT_SCHEMA"]],
          "weight": 0.3
        },
        {
          "label": "Targets include the authoritative schema source",
          "source": "target_paths",
          "groups": [["src/explorer/schemas.mjs"]],
          "weight": 0.25
        },
        {
          "label": "State permits a narrow handoff",
          "source": "result_state",
          "groups": [["complete", "verify_targets"]],
          "weight": 0.15,
          "minCoverage": 0.5
        }
      ],
      "checks": [
        { "label": "Has direct answer", "type": "has_direct_answer", "value": true, "weight": 0.1 },
        { "label": "Targets present", "type": "min_target_count", "value": 1, "weight": 0.1 },
        { "label": "Target set stays narrow", "type": "max_target_count", "value": 4, "weight": 0.1 }
      ]
    }
  ]
}
