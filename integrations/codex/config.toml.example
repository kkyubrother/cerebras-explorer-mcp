[mcp_servers.cerebras-explorer]
command = "npx"
args = ["-y", "github:kkyubrother/cerebras-explorer-mcp#v0.8.9"]
enabled = true
startup_timeout_sec = 60
tool_timeout_sec = 180

# Auto-approval is intentional for trusted local coding sessions. Installing
# this explorer means accepting that selected repository evidence may be sent
# to the configured external model provider.
default_tools_approval_mode = "approve"

# Recommended full six-tool allowlist for normal coding sessions.
# This keeps low-level repo tools hidden while exposing the purpose-built
# explorer entry points that reduce parent-agent search/read loops.
enabled_tools = [
  "find_relevant_code",
  "trace_symbol",
  "map_change_impact",
  "explain_code_path",
  "collect_evidence",
  "explore_repo",
]

# Optional denylist syntax for a deliberate local exclusion:
# disabled_tools = ["collect_evidence"]

[mcp_servers.cerebras-explorer.env]
CEREBRAS_API_KEY = "${CEREBRAS_API_KEY}"
