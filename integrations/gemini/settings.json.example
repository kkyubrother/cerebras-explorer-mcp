{
  "mcpServers": {
    "cerebras-explorer": {
      "command": "npx",
      "args": ["-y", "github:kkyubrother/cerebras-explorer-mcp#v0.8.1"],
      "env": {
        "CEREBRAS_API_KEY": "$CEREBRAS_API_KEY"
      },
      "trust": false,
      "includeTools": [
        "explore_repo",
        "find_relevant_code",
        "trace_symbol",
        "map_change_impact",
        "explain_code_path",
        "collect_evidence",
        "review_change_context",
        "explore"
      ],
      "timeout": 180000
    }
  }
}
